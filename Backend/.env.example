# Copy values into Backend/.env (never commit .env).
# Gmail: Google Account → Security → 2-Step Verification → App passwords.
# EMAIL_USER / EMAIL_PASS are also accepted as SMTP login fallbacks.

EMAIL_USER=youremail@gmail.com
EMAIL_PASS=your-16-char-app-password
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=youremail@gmail.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM=youremail@gmail.com

# EVC Plus / WaafiPay (appointment booking payments)
EVC_MERCHANT_UID=
EVC_API_USER_ID=
EVC_API_KEY=
EVC_API_URL=https://api.waafipay.net/asm
EVC_PLUS_ENABLED=true
APPOINTMENT_FEE_USD=0.01
EVC_TIMEOUT_SECONDS=120
